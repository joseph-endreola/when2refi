{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "when2refi-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-16",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"CLERK_JWKS_URL": "https://crucial-airedale-3.clerk.accounts.dev/.well-known/jwks.json"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "when2refi-db",
			"database_id": "d8dbd893-426a-489f-9a69-9d2b6edd42dd"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "when2refi-assets",
			"binding": "when2refi_assets"
		}
	]
}